ENVIRONMENT=local|development|production|test
TZ=UTC

HOST=localhost:8000
SERVER_PORT=8000

LOG_LEVEL=debug

DB_TYPE=mysql
DB_USERNAME=root
DB_PASSWORD=secret
DB_HOST=database
DB_PORT=3306
DB_NAME=boilerplate

ADMINER_PORT=5001
DEBUG_PORT=5002

SERVICE_ACCOUNT_KEY=serviceAccountKey.json

STORAGE_BUCKET_NAME=readytoworkjapan.appspot.com

SENTRY_DSN=

# Comma-separated origins (e.g. https://app.example.com,https://admin.example.com).
# Leave empty for AllowAllOrigins without credentials (suitable for local dev).
CORS_ALLOWED_ORIGINS=

ADMIN_EMAIL=
ADMIN_PASS=

# Twilio
TWILIO_BASE_URL=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

#Email
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_ACCESS_TOKEN=
MAIL_REFRESH_TOKEN=

#AWS
AWS_S3_REGION=XXX
AWS_S3_BUCKET=XXX
AWS_ACCESS_KEY=XXX
AWS_SECRET_KEY=XXX

#JWT
JWT_ACCESS_SECRET=XXX
JWT_REFRESH_SECRET=XXX
JWT_ACCESS_TOKEN_EXPIRES_AT=30 # In minutes
JWT_REFRESH_TOKEN_EXPIRES_AT=12 # In hour

# Idempotency cache (replays POST responses for retried requests carrying the
# same Idempotency-Key header). One of: "" | "none" | "mysql" | "redis".
IDEMPOTENCY_STORE=
# Go duration string, e.g. "24h" or "30m". Default 24h.
IDEMPOTENCY_TTL=24h

# Redis — only required when IDEMPOTENCY_STORE=redis (or for any future
# Redis-backed feature). Leave empty otherwise.
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# DB connection pool — sensible defaults are applied if these are empty.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

#Budget Notification
PROJECT_NAME=readytowork
BILLING_ACCOUNT_ID=0116BB-3ENMFD-EE1ED2
BUDGET_DISPLAY_NAME=Project Budget Name
BUDGET_AMOUNT=30000
SET_BUDGET=0

#Circle CI Credentials
CIRCLECI_TOKEN=XXXXXX
ORG_ID=XXXXX
